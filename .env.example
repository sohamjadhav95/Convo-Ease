# Copy this file to .env and fill in the values. Never commit .env.

# --- AI provider -------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: use a different provider (gemini | groq | nvidia | custom)
# CONVOEASE_AI_PROVIDER=gemini
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# Any OpenAI-compatible API (OpenRouter, Ollama, OpenAI...):
# CONVOEASE_AI_PROVIDER=custom
# CONVOEASE_API_URL=https://openrouter.ai/api/v1
# CONVOEASE_API_KEY=
# CONVOEASE_TEXT_MODEL_ID=
# CONVOEASE_IMAGE_MODEL_ID=
# CONVOEASE_AUDIO_MODEL_ID=

# Optional: change models without touching code
# CONVOEASE_TEXT_MODEL_ID=gemini-3.5-flash-lite
# CONVOEASE_IMAGE_MODEL_ID=gemini-3.5-flash-lite
# CONVOEASE_AUDIO_MODEL_ID=gemini-3.5-flash-lite

# --- Database ----------------------------------------------------------------
# Leave empty to use a local SQLite file (database/convoease.db).
# In production use a hosted Postgres URL, e.g. from https://neon.tech
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Server ------------------------------------------------------------------
# development (default) or production
# CONVOEASE_ENV=development
# Required in production. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# CONVOEASE_SECRET_KEY=
# CONVOEASE_PORT=5000
